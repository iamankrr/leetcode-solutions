class Solution {
  public:
    int maxSubarraySum(vector<int>& nums, int k) {
    
        int n = nums.size();
        int maxSum = 0;
        int sum = 0;
       
        //1 window
        for(int i = 0; i < k ; i++){
            sum += nums[i];    
        }
        maxSum = sum;
        
        for(int j = k ; j < n ; j++){
            sum += nums[j];
            sum -= nums[j-k];
            
            maxSum = max(maxSum,sum);
        }
        return maxSum;
    }
};
