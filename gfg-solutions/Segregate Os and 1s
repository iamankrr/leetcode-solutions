class Solution {
  public:
    void segregate0and1(vector<int> &nums) {
        
        int n= nums.size();
        int st = 0, end = 0;
        
        while(end < n){
            if(nums[end] == 1){
                end++;
            }else{
                swap(nums[end],nums[st]);
                st++;
                end++;
            }
        }
    }
};
